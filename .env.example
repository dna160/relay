# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# --- Auth (Auth.js v5, email provider only — no password surface) ---------
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Client magic-link codes are signed with this. Rotating it invalidates
# outstanding client links, which is the intended blast radius.
CLIENT_LINK_SECRET=change-me-too

# --- Object storage (INV-10: bytes never traverse the app server) ---------
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=relay-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Email ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Relay <no-reply@example.com>"

# --- Retention ------------------------------------------------------------
# Overridable only in dev so the 60-day timeline can be exercised in a test run.
RETENTION_ARCHIVE_DAYS=30
RETENTION_PURGE_DAYS=60
# Signs purge certificates. Must be stable across deploys or old certificates
# stop verifying.
CERTIFICATE_SIGNING_KEY=
