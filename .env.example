# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# --- App ------------------------------------------------------------------
# The public origin, inlined into the client bundle at build time. Client-side
# fetches resolve against it; absent, they fall back to localhost:3000 and a
# deployed browser calls the wrong host. Must match AUTH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Auth.js v5, email provider only — no password surface) ---------
AUTH_SECRET=change-me-openssl-rand-base64-32
# Also what Auth.js derives `trustHost` from. Absent behind Railway's proxy,
# and with no AUTH_TRUST_HOST, the first sign-in attempt is an UntrustedHost
# failure rather than an email. See ADR-017.
AUTH_URL=http://localhost:3000
# Client magic-link codes are signed with this. Rotating it invalidates
# outstanding client links, which is the intended blast radius.
CLIENT_LINK_SECRET=change-me-too

# --- Object storage (INV-10: bytes never traverse the app server) ---------
# These are the LOCAL MinIO values, and they are filled in on purpose. Until
# they were, no local run and no CI run had an object-storage endpoint at all:
# the presign route 500s without one, so no PUT was ever made, and the e2e
# assertion "no PUT reached the app server" was being made against a run with
# no PUT in it. `npm run db:up` starts MinIO alongside Postgres; verify with
# `npm run storage:check`, which creates the bucket and round-trips an object.
#
# In production these are R2: S3_ENDPOINT becomes
# https://<accountid>.r2.cloudflarestorage.com, S3_REGION stays `auto`, and the
# two keys come from the Railway environment rather than from this file.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=relay-dev
S3_ACCESS_KEY_ID=change-me-minio
S3_SECRET_ACCESS_KEY=change-me-minio-local
S3_PUBLIC_BASE_URL=

# --- Email ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Relay <no-reply@example.com>"

# --- Retention ------------------------------------------------------------
# Overridable only in dev so the 60-day timeline can be exercised in a test run.
RETENTION_ARCHIVE_DAYS=30
RETENTION_PURGE_DAYS=60
# Signs purge certificates. Must be stable across deploys or old certificates
# stop verifying.
CERTIFICATE_SIGNING_KEY=

# --- Connection pool ------------------------------------------------------
# Size of the pg pool in each process. Chosen against Postgres `max_connections`:
# app replicas x PGPOOL_MAX, plus the worker's own pool, must stay under it.
# Absent, the pool falls back to 10. See the env registry in docs/RUNBOOK.md.
PGPOOL_MAX=10
